NEXT_PUBLIC_SITE_NAME=Lê Hoài Mến - Đồ Thủ Công Handmade
NEXT_PUBLIC_SITE_URL=https://your-domain.com
NEXT_PUBLIC_PHONE=0123456789
NEXT_PUBLIC_ZALO=0123456789
NEXT_PUBLIC_FACEBOOK=https://facebook.com/lehoaimen
NEXT_PUBLIC_SHOPEE=https://shopee.vn/lehoaimen

# Admin Auth
ADMIN_USERNAME=replace-with-a-private-admin-name
ADMIN_PASSWORD=replace-with-a-unique-password-longer-than-12-chars
JWT_SECRET=replace-with-a-unique-random-secret-at-least-32-characters

# Database
DATABASE_PATH=./data/shop.db

# VNPAY (Optional - configure when ready)
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=https://your-domain.com/thanh-toan/vnpay-return

# Google Analytics (Optional)
NEXT_PUBLIC_GA_ID=

# Meta Pixel (Optional)  
NEXT_PUBLIC_META_PIXEL_ID=


# Order notifications (secrets stay server-side; never use NEXT_PUBLIC_ prefixes)
NOTIFICATION_WEBHOOK_SECRET=replace-with-a-random-secret-at-least-32-characters
SEPAY_WEBHOOK_SECRET=replace-with-the-HMAC-secret-configured-in-SePay
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=
# Backward-compatible alternative:
TELEGRAM_CHAT_ID=
